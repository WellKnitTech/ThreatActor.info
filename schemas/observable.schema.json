{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threatactor.info/schemas/observable.schema.json",
  "title": "ThreatActor.info Observable v1",
  "type": "object",
  "required": ["id", "type", "value", "normalized_value", "atomic", "status", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^obs_v1_[a-f0-9]{64}$" },
    "type": { "enum": ["ip_address", "domain", "url", "email", "md5", "sha1", "sha256", "sha512", "file_path", "registry_key", "mutex", "certificate", "cve", "attack_technique"] },
    "value": { "type": "string", "minLength": 1 },
    "normalized_value": { "type": "string", "minLength": 1 },
    "canonical_value": { "type": "string", "minLength": 1 },
    "display_value": { "type": "string", "minLength": 1 },
    "atomic": { "const": true },
    "status": { "enum": ["active", "deprecated", "false_positive", "quarantined"] },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "precision": { "enum": ["instant", "day"] },
    "confidence": { "type": "object", "additionalProperties": true },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
  },
  "$defs": {
    "source": { "type": "object", "required": ["source", "retrieved_at"], "properties": { "source": { "type": "string", "minLength": 1 }, "record_id": { "type": "string" }, "record_url": { "type": "string", "format": "uri" }, "retrieved_at": { "type": "string", "format": "date-time" }, "status": { "enum": ["active", "deprecated", "false_positive", "quarantined"] } }, "additionalProperties": true },
    "relationship": { "type": "object", "required": ["target_kind", "target_id", "role"], "properties": { "target_kind": { "enum": ["actor", "malware", "campaign", "operation", "report"] }, "target_id": { "type": "string", "minLength": 1 }, "role": { "type": "string", "minLength": 1 }, "status": { "enum": ["active", "deprecated", "false_positive", "quarantined"] } }, "additionalProperties": true }
  },
  "additionalProperties": true
}